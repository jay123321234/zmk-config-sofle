#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_1 {
            bindings = <
&kp ESC     &kp N1   &kp N2    &kp N3     &kp N4        &kp N5       &kp UP     &kp N6  &kp N7            &kp N8     &kp N9          &kp N0     &kp BSPC
&kp TAB     &kp Q    &kp W     &kp E      &kp R         &kp T        &kp DOWN   &kp Y   &kp U             &kp I      &kp O           &kp P      &kp GRAVE
&kp CAPS    &kp A    &kp S     &kp D      &kp F         &kp G        &kp LEFT   &kp H   &kp J             &kp K      &kp L           &kp SEMI   &kp APOS
&kp LSHFT   &kp Z    &kp X     &kp C      &kp V         &kp B        &kp RIGHT  &kp N   &kp M             &kp COMMA  &kp DOT         &kp FSLH   &kp RSHFT
&kp K_MUTE  &kp DEL  &kp LALT  &kp LCTRL  &kp LEFT_WIN  &kp ENTER    &kp ENTER  &tog 1  &kp LANG_HANGEUL  &kp SPACE  &kp LANGUAGE_2  &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_2 {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp UP     &kp F7          &kp F8          &kp F9           &kp F10   &kp F11    &kp F12
&kp TAB    &trans  &trans  &trans  &trans  &trans    &kp DOWN   &trans          &msc SCRL_UP    &trans           &kp LBKT  &kp RBKT   &kp MINUS
&trans     &trans  &trans  &trans  &trans  &trans    &kp LEFT   &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans     &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans    &kp RIGHT  &trans          &trans          &trans           &trans    &kp RSHFT  &kp RSHFT
&trans     &trans  &trans  &trans  &trans  &trans    &trans     &tog 0          &trans          &trans           &trans    &trans
            >;
        };
    };
};
